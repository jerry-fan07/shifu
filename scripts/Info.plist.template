<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Named ShifuApp, not Shifu: the CLI ships beside it as `shifu`, and on
         a case-insensitive filesystem Shifu and shifu are the same file — the
         v0.1.0 bundle shipped with the CLI silently overwriting the app. -->
    <key>CFBundleExecutable</key><string>ShifuApp</string>
    <key>CFBundleIdentifier</key><string>com.shifu.app</string>
    <key>CFBundleName</key><string>Shifu</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>__VERSION__</string>
    <key>CFBundleVersion</key><string>__BUILD__</string>
    <!-- Which Shifu this bundle is sold as (Edition.current): "standard"
         offers the hosted backends, "qwen" only the local one. Stamped by
         bundle-app.sh like the version, so a bundle cannot claim an edition
         other than the one it was assembled as. -->
    <key>ShifuEdition</key><string>__EDITION__</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>NSHumanReadableCopyright</key><string>© 2026 Jerry Fan</string>
</dict>
</plist>
