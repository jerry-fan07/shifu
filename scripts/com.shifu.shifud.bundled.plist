<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- LaunchAgent registered via SMAppService.agent(plistName:) — ships inside
     Shifu.app/Contents/Library/LaunchAgents. Unlike the dev template
     (com.shifu.shifud.plist.template) this file is baked at build time, so it
     cannot name the user's home: shifud redirects its own output to
     ~/Shifu/logs when given the log-file flag. -->
<dict>
    <key>Label</key>
    <string>com.shifu.shifud</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/shifud</string>
    <key>ProgramArguments</key>
    <array>
        <string>shifud</string>
        <string>--log-file</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
